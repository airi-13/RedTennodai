# SupabaseダッシュボードのSettings > API Keys から取得して .env.local にコピーする
# (このファイル自体はサンプルなので値を書き込んでも実際には使われません)

# Project URL (例: https://abxmytcbbmylvwxrwsqg.supabase.co)
SUPABASE_URL=

# service_role key(secret)。RLSを使わずサーバー側から全権アクセスするため使用。
# 絶対にクライアント側のコードやNEXT_PUBLIC_接頭辞の変数には入れないこと。
SUPABASE_SERVICE_ROLE_KEY=

# publishable key(旧anon key)。生徒ログイン(RLS経由)で使用。これは公開して問題ない値。
SUPABASE_PUBLISHABLE_KEY=

# 管理画面(出欠入力・生徒管理・申請)にアクセスするための共有パスワード。任意の文字列。
ADMIN_PASSWORD=
