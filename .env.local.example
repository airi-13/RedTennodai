# SupabaseダッシュボードのSettings > API から取得して .env.local にコピーする
# (このファイル自体はサンプルなので値を書き込んでも実際には使われません)

# Project URL (例: https://abxmytcbbmylvwxrwsqg.supabase.co)
SUPABASE_URL=

# service_role key(secret)。RLSを使わずサーバー側から全権アクセスするため使用。
# 絶対にクライアント側のコードやNEXT_PUBLIC_接頭辞の変数には入れないこと。
SUPABASE_SERVICE_ROLE_KEY=
